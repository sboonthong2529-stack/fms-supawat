// VibeCore Framework Starter Kit. ตารางระดับแพลตฟอร์ม (ไม่มี tenant_id): users, permissions, auth_tokens, login_throttles
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScopeType {
  ALL
  CAMPUS
  ORG_UNIT
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  nameTh    String   @map("name_th") @db.VarChar(255)
  nameEn    String   @map("name_en") @db.VarChar(255)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  /// { palette?: "blue"|"coral"|"pink"|"green"|"purple" }
  settings  Json     @default("{}") @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants UserTenant[]
  roles       Role[]
  auditLogs   AuditLog[]
  sampleItems SampleItem[]
  newsArticles NewsArticle[]
  academicDepartments AcademicDepartment[]
  personnelProfiles   PersonnelProfile[]
  curriculumPrograms  CurriculumProgram[]
  edocTemplates       EdocTemplate[]
  edocRequests        EdocRequest[]
  facilityItems       FacilityItem[]
  facilityBookings    FacilityBooking[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// เก็บตัวพิมพ์เล็กเสมอ
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  /// ชื่อที่แสดง
  name               String    @db.VarChar(255)
  imageUrl           String?   @map("image_url") @db.VarChar(500)
  /// credentials | google | microsoft
  provider           String    @default("credentials") @db.VarChar(20)
  providerId         String?   @map("provider_id") @db.VarChar(255)
  emailVerified      Boolean   @default(false) @map("email_verified")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// th | en | null (= ตามเบราว์เซอร์/ค่าเริ่มต้น)
  locale             String?   @db.VarChar(5)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants UserTenant[]
  authTokens  AuthToken[]
  auditLogs   AuditLog[]   @relation("AuditActor")
  newsArticles NewsArticle[] @relation("NewsAuthor")
  personnelProfile PersonnelProfile?
  reviewedEdocs    EdocRequest[]     @relation("EdocReviewer")
  approvedBookings FacilityBooking[] @relation("BookingApprover")

  @@map("users")
}

model UserTenant {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  isActive Boolean  @default(true) @map("is_active")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// A-Z 0-9 _ เช่น SUPER_ADMIN
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(100)
  nameEn      String   @map("name_en") @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// แก้สิทธิ์/ลบไม่ได้ · SUPER_ADMIN ได้ทุกสิทธิ์โดยไม่ต้องมีแถวใน role_permissions
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

/// ผู้ใช้มีได้หลายแถว (หลายบทบาท / บทบาทเดียวหลายขอบเขต) · unique ที่มี scope_id null ไม่กันซ้ำใน Postgres — service ต้องเขียนแบบลบทั้งชุดแล้วสร้างใหม่
model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userTenantId String    @map("user_tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    ScopeType @default(ALL) @map("scope_type")
  /// campus_id หรือ org_unit_id หรือขอบเขตอื่นที่กำหนดเพิ่ม — null เมื่อ scope_type = ALL
  scopeId      String?   @map("scope_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userTenantId, roleId, scopeType, scopeId])
  @@index([roleId])
  @@map("user_roles")
}

/// seed จาก src/permissions.ts ทุกครั้ง ไม่แก้ผ่าน UI
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// โทเคนใช้ครั้งเดียว — เก็บ sha256 ของโทเคน ไม่เก็บตัวจริง
model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") @db.VarChar(128)
  /// EMAIL_VERIFY: { newEmail }
  payload   Json?        @db.JsonB
  expiresAt DateTime     @map("expires_at") @db.Timestamptz()
  usedAt    DateTime?    @map("used_at") @db.Timestamptz()
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// กันเดารหัสผ่าน แทน Redis · key = "email:<lower>" หรือ "ip:<addr>"
model LoginThrottle {
  key         String    @id @db.VarChar(320)
  failCount   Int       @default(0) @map("fail_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("login_throttles")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  /// เช่น user.create, user.suspend, role.update
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.VarChar(64)
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// โมเดลตัวอย่าง (Sample CRUD) สำหรับให้นักเรียนดูเป็นแม่แบบในการพัฒนาฟีเจอร์ใหม่
model SampleItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sample_items")
}

model NewsArticle {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  titleTh      String       @map("title_th") @db.VarChar(255)
  titleEn      String       @map("title_en") @db.VarChar(255)
  slug         String       @db.VarChar(255)
  summaryTh    String?      @map("summary_th") @db.Text
  summaryEn    String?      @map("summary_en") @db.Text
  contentTh    String       @map("content_th") @db.Text
  contentEn    String       @map("content_en") @db.Text
  coverImageUrl String?     @map("cover_image_url") @db.VarChar(500)
  category     String       @default("GENERAL") @db.VarChar(50)
  status       String       @default("DRAFT") @db.VarChar(50)
  isPinned     Boolean      @default(false) @map("is_pinned")
  viewCount    Int          @default(0) @map("view_count")
  publishedAt  DateTime?    @map("published_at") @db.Timestamptz()
  authorId     String?      @map("author_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author      User?            @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  attachments NewsAttachment[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, category])
  @@map("news_articles")
}

model NewsAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  fileName  String   @map("file_name") @db.VarChar(255)
  fileUrl   String   @map("file_url") @db.VarChar(500)
  fileSize  Int      @map("file_size")
  mimeType  String   @map("mime_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("news_attachments")
}

model AcademicDepartment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  code       String   @db.VarChar(50)
  nameTh     String   @map("name_th") @db.VarChar(255)
  nameEn     String   @map("name_en") @db.VarChar(255)
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personnelProfiles PersonnelProfile[]
  curriculumPrograms CurriculumProgram[]

  @@unique([tenantId, code])
  @@index([tenantId, orderIndex])
  @@map("academic_departments")
}

model PersonnelProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  departmentId        String?  @map("department_id") @db.Uuid
  userId              String?  @unique @map("user_id") @db.Uuid
  academicTitle       String?  @map("academic_title") @db.VarChar(50)
  firstNameTh         String   @map("first_name_th") @db.VarChar(100)
  lastNameTh          String   @map("last_name_th") @db.VarChar(100)
  firstNameEn         String   @map("first_name_en") @db.VarChar(100)
  lastNameEn          String   @map("last_name_en") @db.VarChar(100)
  positionType        String   @default("ACADEMIC") @map("position_type") @db.VarChar(50)
  executivePositionTh String?  @map("executive_position_th") @db.VarChar(255)
  executivePositionEn String?  @map("executive_position_en") @db.VarChar(255)
  isExecutive         Boolean  @default(false) @map("is_executive")
  email               String?  @db.VarChar(255)
  phone               String?  @db.VarChar(50)
  officeRoom          String?  @map("office_room") @db.VarChar(100)
  avatarUrl           String?  @map("avatar_url") @db.VarChar(500)
  bioTh               String?  @map("bio_th") @db.Text
  bioEn               String?  @map("bio_en") @db.Text
  researchInterests   String?  @map("research_interests") @db.Text
  orderIndex          Int      @default(0) @map("order_index")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   AcademicDepartment?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  publications PersonnelPublication[]

  @@index([tenantId, isExecutive, orderIndex])
  @@index([tenantId, departmentId])
  @@index([tenantId, isActive])
  @@map("personnel_profiles")
}

model PersonnelPublication {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  personnelId String   @map("personnel_id") @db.Uuid
  title       String   @db.VarChar(500)
  journal     String?  @db.VarChar(255)
  year        Int?
  externalUrl String?  @map("external_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  personnel PersonnelProfile @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@index([personnelId])
  @@map("personnel_publications")
}

model CurriculumProgram {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  departmentId      String?             @map("department_id") @db.Uuid
  code              String              @db.VarChar(50)
  degreeLevel       String              @default("BACHELOR") @map("degree_level") @db.VarChar(50)
  nameTh            String              @map("name_th") @db.VarChar(255)
  nameEn            String              @map("name_en") @db.VarChar(255)
  degreeNameTh      String              @map("degree_name_th") @db.VarChar(255)
  degreeNameEn      String              @map("degree_name_en") @db.VarChar(255)
  totalCredits      Int                 @default(0) @map("total_credits")
  durationYears     Int                 @default(4) @map("duration_years")
  tuitionFeePerTerm Int?                @map("tuition_fee_per_term")
  descriptionTh     String              @map("description_th") @db.Text
  descriptionEn     String              @map("description_en") @db.Text
  careerPathsTh     String?             @map("career_paths_th") @db.Text
  careerPathsEn     String?             @map("career_paths_en") @db.Text
  curriculumFileUrl String?             @map("curriculum_file_url") @db.VarChar(500)
  coverImageUrl     String?             @map("cover_image_url") @db.VarChar(500)
  orderIndex        Int                 @default(0) @map("order_index")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department AcademicDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  courses    CurriculumCourse[]

  @@unique([tenantId, code])
  @@index([tenantId, degreeLevel, orderIndex])
  @@index([tenantId, departmentId])
  @@index([tenantId, isActive])
  @@map("curriculum_programs")
}

model CurriculumCourse {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  programId      String            @map("program_id") @db.Uuid
  courseCode     String            @map("course_code") @db.VarChar(20)
  nameTh         String            @map("name_th") @db.VarChar(255)
  nameEn         String            @map("name_en") @db.VarChar(255)
  credits        Int               @default(3)
  lectureHours   Int?              @map("lecture_hours")
  labHours       Int?              @map("lab_hours")
  selfStudyHours Int?              @map("self_study_hours")
  courseCategory String            @default("CORE") @map("course_category") @db.VarChar(50)
  year           Int               @default(1)
  semester       Int               @default(1)
  descriptionTh  String?           @map("description_th") @db.Text
  descriptionEn  String?           @map("description_en") @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  program CurriculumProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId, year, semester])
  @@map("curriculum_courses")
}

model EdocTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(255)
  nameEn      String   @map("name_en") @db.VarChar(255)
  category    String   @default("GENERAL") @db.VarChar(50)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  orderIndex  Int      @default(0) @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests EdocRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, category])
  @@map("edoc_templates")
}

model EdocRequest {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  templateId       String?   @map("template_id") @db.Uuid
  trackingCode     String    @map("tracking_code") @db.VarChar(50)
  requesterName    String    @map("requester_name") @db.VarChar(255)
  requesterEmail   String    @map("requester_email") @db.VarChar(255)
  requesterPhone   String?   @map("requester_phone") @db.VarChar(50)
  requesterType    String    @default("STUDENT") @map("requester_type") @db.VarChar(50)
  studentOrStaffId String?   @map("student_or_staff_id") @db.VarChar(50)
  title            String    @db.VarChar(255)
  details          String    @db.Text
  attachmentUrl    String?   @map("attachment_url") @db.VarChar(500)
  status           String    @default("SUBMITTED") @db.VarChar(50)
  reviewerRemarks  String?   @map("reviewer_remarks") @db.Text
  reviewedById     String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   EdocTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  reviewedBy User?         @relation("EdocReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, trackingCode])
  @@index([tenantId, status])
  @@index([tenantId, requesterEmail])
  @@map("edoc_requests")
}

model FacilityItem {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  code       String   @db.VarChar(50)
  nameTh     String   @map("name_th") @db.VarChar(255)
  nameEn     String   @map("name_en") @db.VarChar(255)
  type       String   @default("MEETING_ROOM") @db.VarChar(50)
  capacity   Int      @default(10)
  location   String   @db.VarChar(255)
  amenities  String?  @db.Text
  imageUrl   String?  @map("image_url") @db.VarChar(500)
  isActive   Boolean  @default(true) @map("is_active")
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings FacilityBooking[]

  @@unique([tenantId, code])
  @@index([tenantId, type, isActive])
  @@map("facility_items")
}

model FacilityBooking {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  facilityId      String    @map("facility_id") @db.Uuid
  bookingNumber   String    @map("booking_number") @db.VarChar(50)
  bookerName      String    @map("booker_name") @db.VarChar(255)
  bookerEmail     String    @map("booker_email") @db.VarChar(255)
  bookerPhone     String?   @map("booker_phone") @db.VarChar(50)
  bookerDept      String?   @map("booker_dept") @db.VarChar(100)
  purpose         String    @db.Text
  startTime       DateTime  @map("start_time") @db.Timestamptz()
  endTime         DateTime  @map("end_time") @db.Timestamptz()
  attendeeCount   Int       @default(1) @map("attendee_count")
  status          String    @default("PENDING") @db.VarChar(50)
  rejectionReason String?   @map("rejection_reason") @db.Text
  approvedById    String?   @map("approved_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility   FacilityItem @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  approvedBy User?        @relation("BookingApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, bookingNumber])
  @@index([tenantId, facilityId, startTime, endTime])
  @@index([tenantId, status])
  @@map("facility_bookings")
}



