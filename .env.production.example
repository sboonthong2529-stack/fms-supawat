# ========================================================
# Production Environment Variables for Docker Deployment
# ========================================================

# Application Port on Host
APP_PORT=3010
APP_URL=http://localhost:3010

# Database Configuration (for fms-db container)
DB_USER=fms_admin
DB_PASSWORD=change_this_to_a_strong_database_password
DB_NAME=fms_production

# Authentication Secret (Base64 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=generate_base64_32_bytes_random_secret_here
AUTH_TRUST_HOST=true

# Initial Bootstrap Super Admin (run db:bootstrap)
BOOTSTRAP_ADMIN_EMAIL=admin@app.local
BOOTSTRAP_ADMIN_PASSWORD=change_this_to_a_strong_admin_password

# Email SMTP (Optional - leaves empty to log to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FMS System <no-reply@fms.local>